{
  "title": "Risalah SEKNEG — Platform Overview",
  "uid": "risalah-overview",
  "tags": ["risalah", "sekneg"],
  "timezone": "Asia/Jakarta",
  "panels": [
    {
      "title": "Active Users",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_requests_total{namespace=\"risalah-app\"}[5m]))" }]
    },
    {
      "title": "API Latency p95",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))" }]
    },
    {
      "title": "AI Pipeline — Transcription Queue",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "celery_queue_length{queue=\"transcription\"}" }]
    },
    {
      "title": "Error Rate by Service",
      "type": "bargauge",
      "datasource": "Loki",
      "targets": [{ "expr": "sum(rate({namespace=~\"risalah-.+\"} |= \"error\" [5m])) by (namespace)" }]
    }
  ]
}
