# ─── Database ───
DATABASE_URL=postgres://risalah:${DB_PASSWORD}@postgres:5432/risalah

# ─── Auth ───
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# ─── AI Service ───
NEXT_PUBLIC_AI_SERVICE_URL=https://ai.risalah.sekneg.go.id

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── Object Storage ───
STORAGE_ENDPOINT=minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=risalah
STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
STORAGE_BUCKET=risalah-audio
STORAGE_USE_SSL=false

# ─── SMTP ───
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
EMAIL_FROM=noreply@risalah.sekneg.go.id
APP_URL=https://app.risalah.sekneg.go.id

# ─── App ───
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.risalah.sekneg.go.id
